# Code signing and notarization. Copy to `.env` (git-ignored) or export in CI.
# forge.config.mts enables each step only when its variables are set; leave them empty for
# unsigned local builds. Never commit real values.

# --- macOS signing ------------------------------------------------------------------------
# Name of a "Developer ID Application" certificate in the keychain, e.g.
# "Developer ID Application: Your Name (TEAMID1234)".
APPLE_SIGNING_IDENTITY=

# --- macOS notarization (requires APPLE_SIGNING_IDENTITY) -----------------------------------
# Option A (recommended): App Store Connect API key.
# APPLE_API_KEY is the absolute path to AuthKey_XXXXXXXXXX.p8; omit APPLE_API_ISSUER for
# individual API keys.
APPLE_API_KEY=
APPLE_API_KEY_ID=
APPLE_API_ISSUER=
# Option B: Apple ID with an app-specific password.
APPLE_ID=
APPLE_APP_SPECIFIC_PASSWORD=
APPLE_TEAM_ID=

# --- Windows signing ------------------------------------------------------------------------
# Signs the app (via @electron/windows-sign) and the Squirrel installer.
# WINDOWS_CERTIFICATE_FILE is the absolute path to a .pfx file.
WINDOWS_CERTIFICATE_FILE=
WINDOWS_CERTIFICATE_PASSWORD=
