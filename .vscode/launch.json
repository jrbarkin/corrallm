{
  "version": "0.2.0",
  "configurations": [
    {
      // Starts `electron-forge start` with the main process under the debugger.
      // Points at Forge's script directly: the node_modules/.bin symlink breaks its relative paths.
      "name": "Electron: Main",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "runtimeExecutable": "${workspaceFolder}/node_modules/@electron-forge/cli/script/vscode.sh",
      "windows": {
        "runtimeExecutable": "${workspaceFolder}/node_modules/@electron-forge/cli/script/vscode.cmd"
      },
      // Lets "Electron: Renderer" attach to the window.
      "runtimeArgs": ["--remote-debugging-port=9223"],
      "console": "integratedTerminal",
      "sourceMaps": true,
      "outFiles": ["${workspaceFolder}/.vite/build/**/*.cjs"]
    },
    {
      "name": "Electron: Renderer",
      "type": "chrome",
      "request": "attach",
      "port": 9223,
      "webRoot": "${workspaceFolder}/src/renderer",
      "timeout": 60000
    }
  ],
  "compounds": [
    {
      "name": "Electron: Main + Renderer",
      "configurations": ["Electron: Main", "Electron: Renderer"],
      "stopAll": true
    }
  ]
}
