{
  "name": "corrallm",
  "productName": "corrallm",
  "version": "0.1.0",
  "private": true,
  "description": "Desktop orchestrator for coding-agent CLIs",
  "author": "jrbarkin <jrbarkin1@gmail.com>",
  "license": "Apache-2.0",
  "type": "module",
  "main": ".vite/build/main.cjs",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": "^24.21.0"
  },
  "scripts": {
    "dev": "electron-forge start",
    "typecheck": "tsc -b",
    "lint": "eslint --max-warnings=0 .",
    "lint:fix": "eslint --fix .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "build:cli": "vite build --config vite.cli.config.mts",
    "corrallm": "node scripts/corrallm.mjs",
    "api:surface": "vitest run --project main src/shared/api/surface.test.ts --update",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,mts,cts,js,mjs,cjs}": [
      "eslint --fix --max-warnings=0 --no-warn-ignored",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css,html}": "prettier --write"
  },
  "dependencies": {
    "node-pty": "1.2.0-beta.14"
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.306",
    "@anthropic-ai/sdk": "^0.137.0",
    "@dagrejs/dagre": "^3.1.1",
    "@electron-forge/cli": "^8.0.1",
    "@electron-forge/maker-deb": "^8.0.1",
    "@electron-forge/maker-dmg": "^8.0.1",
    "@electron-forge/maker-rpm": "^8.0.1",
    "@electron-forge/maker-squirrel": "^8.0.1",
    "@electron-forge/maker-zip": "^8.0.1",
    "@electron-forge/plugin-fuses": "^8.0.1",
    "@electron-forge/plugin-vite": "^8.0.1",
    "@electron-forge/shared-types": "^8.0.1",
    "@electron/fuses": "^2.1.3",
    "@eslint/js": "^10.0.1",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@playwright/test": "^1.64.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/electron-squirrel-startup": "^1.0.2",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/semver": "7.7.1",
    "@vitejs/plugin-react": "^6.1.2",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-serialize": "0.14.0",
    "@xterm/addon-unicode11": "0.9.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/addon-webgl": "0.19.0",
    "@xterm/headless": "6.0.0",
    "@xterm/xterm": "6.0.0",
    "@xyflow/react": "^12.12.0",
    "electron": "44.7.0",
    "electron-squirrel-startup": "^1.0.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "jsdom": "^30.1.3",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "semver": "7.8.5",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.3",
    "zod": "4.6.7"
  },
  "peerDependencies": {
    "electron-winstaller": "^5.4.0"
  }
}
