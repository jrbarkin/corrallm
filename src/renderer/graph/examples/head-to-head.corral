{
  "format": "corrallm",
  "version": 1,
  "nodes": [
    {
      "id": "claude",
      "kind": "agent",
      "label": "Claude",
      "position": {
        "x": 0,
        "y": 0
      },
      "agent": "Claude",
      "queue": [
        {
          "id": "worktree",
          "action": "EnterWorktree"
        },
        {
          "id": "rounds",
          "repeat": [
            {
              "id": "build",
              "message": "You're competing with another agent to build the best version of this, on a branch named compete/claude: commit when you're done. If the judge has left notes in .compete/feedback-claude.md in the main checkout (`git worktree list` shows where it is), improve your version from them.\n\n{{task}}"
            },
            {
              "id": "scored",
              "waitFor": [
                {
                  "agent": "judge",
                  "item": "judge"
                }
              ]
            }
          ],
          "until": {
            "kind": "repeatEnds",
            "agent": "judge",
            "item": "judging"
          },
          "rounds": 2,
          "otherwise": "goOn"
        }
      ]
    },
    {
      "id": "codex",
      "kind": "agent",
      "label": "Codex",
      "position": {
        "x": 400,
        "y": 0
      },
      "agent": "Codex",
      "queue": [
        {
          "id": "worktree",
          "action": "/worktree"
        },
        {
          "id": "rounds",
          "repeat": [
            {
              "id": "build",
              "message": "You're competing with another agent to build the best version of this, on a branch named compete/codex: commit when you're done. If the judge has left notes in .compete/feedback-codex.md in the main checkout (`git worktree list` shows where it is), improve your version from them.\n\n{{task}}"
            },
            {
              "id": "scored",
              "waitFor": [
                {
                  "agent": "judge",
                  "item": "judge"
                }
              ]
            }
          ],
          "until": {
            "kind": "repeatEnds",
            "agent": "judge",
            "item": "judging"
          },
          "rounds": 2,
          "otherwise": "goOn"
        }
      ]
    },
    {
      "id": "judge",
      "kind": "agent",
      "label": "Judge",
      "position": {
        "x": 200,
        "y": 260
      },
      "agent": "Claude",
      "queue": [
        {
          "id": "judging",
          "repeat": [
            {
              "id": "built",
              "waitFor": [
                {
                  "agent": "claude",
                  "item": "build"
                },
                {
                  "agent": "codex",
                  "item": "build"
                }
              ]
            },
            {
              "id": "judge",
              "message": "Two agents just built this, on the branches compete/claude and compete/codex:\n\n{{task}}\n\nJudge them blind: call them Version A and Version B in a random order (`echo $((RANDOM % 2))`), and don't look at which is which until you've scored. Score each from 0 to 100 for how well it does what was asked, its design, and its code. Then write what each should improve to .compete/feedback-claude.md and .compete/feedback-codex.md. If one version is clearly better, say WINNER."
            }
          ],
          "until": {
            "kind": "outputContains",
            "text": "WINNER"
          },
          "rounds": 2,
          "otherwise": "goOn"
        },
        {
          "id": "merge",
          "message": "Merge the winner's branch (without a clear winner, the one with the higher total over the rounds), and say why it won."
        }
      ]
    }
  ],
  "links": []
}
