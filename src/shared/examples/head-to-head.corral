  "id": "6160af62-718e-4ae2-bb27-1a2ec6743130",
  "nodes": [
    {
      "id": "claude",
      "kind": "agent",
      "label": "Claude",
      "position": {
        "x": 0,
        "y": 0
      },
      "adapter": "claude-code",
      "queue": [
        {
          "id": "worktree",
          "message": "Use your corrallm-managed workspace for your role. Keep its current generated branch and checkout. Read the core-supplied workspace context for your captured base and the generated refs of the other roles. If that context or Judge’s ref is missing, ask for it and stop; never invent refs, search sibling directories, or create a native worktree."
        },
        {
          "id": "rounds",
          "repeat": [
            {
              "id": "build",
              "message": "Build the best version of the task below for your role, in your corrallm-managed worktree on your own generated branch. The core workspace context supplies the refs; never use a hard-coded branch name. For round 1 there is no prior feedback. For round 2, read Judge’s committed feedback with `git show <judge-ref>:.compete/feedback-claude.md`; its Round must match your completed round in .compete/result.md. The wait only orders turns and does not deliver Judge’s reply. If the ref, feedback commit or expected round is missing, report what is missing and ask before proceeding; do not read another checkout or substitute a reply. Improve your version from that committed feedback.\n\nBefore ending each round, write .compete/result.md with `Round: N` and a summary, and commit it together with your completed implementation on your own branch. Never merge the other contestant or Judge. Report the resulting commit id.\n\n{{task}}"
            },
            {
              "id": "scored",
              "waitFor": [
                {
                  "agent": "judge",
                  "item": "judge"
                }
              ]
            }
          ],
          "until": {
            "kind": "repeatEnds",
            "agent": "judge",
            "item": "judging"
          },
          "rounds": 2,
          "otherwise": "goOn"
        }
      ]
    },
    {
      "id": "codex",
      "kind": "agent",
      "label": "Codex",
      "position": {
        "x": 400,
        "y": 0
      },
      "adapter": "codex",
      "queue": [
        {
          "id": "worktree",
          "message": "Use your corrallm-managed workspace for your role. Keep its current generated branch and checkout. Read the core-supplied workspace context for your captured base and the generated refs of the other roles. If that context or Judge’s ref is missing, ask for it and stop; never invent refs, search sibling directories, or create a native worktree."
        },
        {
          "id": "rounds",
          "repeat": [
            {
              "id": "build",
              "message": "Build the best version of the task below for your role, in your corrallm-managed worktree on your own generated branch. The core workspace context supplies the refs; never use a hard-coded branch name. For round 1 there is no prior feedback. For round 2, read Judge’s committed feedback with `git show <judge-ref>:.compete/feedback-codex.md`; its Round must match your completed round in .compete/result.md. The wait only orders turns and does not deliver Judge’s reply. If the ref, feedback commit or expected round is missing, report what is missing and ask before proceeding; do not read another checkout or substitute a reply. Improve your version from that committed feedback.\n\nBefore ending each round, write .compete/result.md with `Round: N` and a summary, and commit it together with your completed implementation on your own branch. Never merge the other contestant or Judge. Report the resulting commit id.\n\n{{task}}"
            },
            {
              "id": "scored",
              "waitFor": [
                {
                  "agent": "judge",
                  "item": "judge"
                }
              ]
            }
          ],
          "until": {
            "kind": "repeatEnds",
            "agent": "judge",
