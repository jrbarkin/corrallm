  "format": "corrallm-template",
  "version": 1,
  "id": "2f1ad1f9-7978-4f49-b7ae-39291affdcf9",
  "nodes": [
    {
      "id": "workspace",
      "kind": "group",
      "label": "Release checks",
      "position": {
        "x": -20,
        "y": -52
      },
      "color": 0
    },
    {
      "id": "releaser",
      "kind": "agent",
      "label": "Releaser",
      "position": {
        "x": 20,
        "y": 52
      },
      "parent": "workspace",
      "queue": [
        {
          "id": "brief",
          "message": "Get main ready to release."
        },
        {
          "id": "tests",
          "instruction": "Run the full test suite, then say how many tests failed as “N failed” on a line of its own.",
          "job": "shell"
        },
        {
          "id": "red",
          "if": {
            "kind": "failed"
          },
          "then": [
            {
              "id": "fix",
              "message": "The tests fail on main: find out why, and fix it. Then run the full test suite and end your reply with “N failed” on a line of its own, giving the number of tests that failed.",
              "target": "fixer"
            }
          ]
        },
        {
          "id": "green",
          "if": {
            "kind": "outputContains",
            "text": "0 failed",
            "wholeLine": true
          },
          "then": [
            {
              "id": "audit",
              "message": "Review the changes for security issues. Report concrete risks and how to fix them."
            },
            {
              "id": "tag",
              "message": "Tag the release and write its notes."
            }
          ]
        }
      ]
    },
    {
      "id": "fixer",
      "kind": "agent",
      "label": "Fixer",
      "position": {
        "x": 380,
        "y": 212
      },
      "parent": "workspace"
    }
  ],
  "links": []
}
