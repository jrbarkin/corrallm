{
  "format": "corrallm",
  "version": 2,
  "id": "fb9ce84a-7237-4271-b494-933cb4d5f274",
  "nodes": [
    {
      "id": "workspace",
      "kind": "group",
      "label": "Spec and implementation",
      "position": {
        "x": -20,
        "y": -52
      },
      "color": 0
    },
    {
      "id": "planner",
      "kind": "agent",
      "label": "Planner",
      "position": {
        "x": 20,
        "y": 52
      },
      "parent": "workspace",
      "queue": [
        {
          "id": "spec",
          "message": "Before any code, write a spec for this to SPEC.md: the problem, what people can do, what's out of scope, and how we'll know it works. Ask me whatever the code can't answer.\n\n{{feature}}"
        },
        {
          "id": "spec-ok",
          "approve": "the spec in SPEC.md"
        },
        {
          "id": "plan",
          "message": "Turn SPEC.md into PLAN.md: small tasks in order, each naming the files it touches and the test that proves it's done."
        }
      ]
    },
    {
      "id": "builder",
      "kind": "agent",
      "label": "Builder",
      "position": {
        "x": 20,
        "y": 272
      },
      "parent": "workspace",
      "queue": [
        {
          "id": "planned",
          "waitFor": [
            {
              "agent": "planner",
              "item": "plan"
            }
          ]
        },
        {
          "id": "write-tests",
          "message": "Write the tests PLAN.md names, for every task, and nothing else: don't build anything yet. Put them where this project keeps its tests."
        },
        {
          "id": "red",
          "action": "Bash",
          "instruction": "Run the new tests.",
          "expect": "fails"
        },
        {
          "id": "red-check",
          "if": {
            "kind": "failed"
          },
          "then": [
            {
              "id": "make-red",
              "message": "The new tests pass before anything is built, so they don't test anything new. Make them fail until PLAN.md's work is done."
            }
          ]
        },
        {
          "id": "build",
          "message": "Work through PLAN.md one task at a time: make its tests pass, fixing the code and not the tests, then tick the task off. If the plan turns out to be wrong, stop and say why."
        },
        {
          "id": "tests",
          "action": "Bash",
          "instruction": "Run the tests."
        }
      ]
    },
    {
      "id": "reviewer",
      "kind": "agent",
      "label": "Reviewer",
      "position": {
        "x": 20,
        "y": 492
      },
      "parent": "workspace",
      "queue": [
        {
          "id": "built",
          "waitFor": [
            {
              "agent": "builder"
            }
          ]
        },
        {
          "id": "review",
          "action": "/code-review"
        },
        {
          "id": "verify",
          "message": "Check the work against SPEC.md: every requirement met and tested, and nothing built that the spec leaves out. List anything missing or wrong."
        },
        {
          "id": "gaps",
          "if": {
            "kind": "freeText",
            "text": "something in the spec is missing or wrong"
          },
          "then": [
            {
              "id": "send-back",
              "message": "The review found gaps against SPEC.md. Fix them, then run the tests.",
              "target": "builder"
            }
          ]
        }
      ]
    }
  ],
  "links": []
}
