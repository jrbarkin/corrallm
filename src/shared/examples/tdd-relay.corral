{
  "format": "corrallm",
  "version": 2,
  "id": "619067df-7b8c-4d38-adea-d5064f06f091",
  "nodes": [
    {
      "id": "workspace",
      "kind": "group",
      "label": "TDD relay",
      "position": {
        "x": -20,
        "y": -52
      },
      "color": 0
    },
    {
      "id": "tester",
      "kind": "agent",
      "label": "Tester",
      "position": {
        "x": 20,
        "y": 52
      },
      "parent": "workspace",
      "adapter": "codex",
      "queue": [
        {
          "id": "write-tests",
          "message": "Write {{framework}} tests for this, and nothing else: don't implement it.\n\n{{feature}}\n\nPut them where this project keeps its tests, named the way the others are."
        },
        {
          "id": "red",
          "action": "exec_command",
          "instruction": "Run the new tests.",
          "expect": "fails"
        },
        {
          "id": "red-check",
          "if": {
            "kind": "failed"
          },
          "then": [
            {
              "id": "make-red",
              "message": "The new tests pass before anything is implemented, so they don't test anything new. Make them fail until the feature exists."
            }
          ]
        }
      ]
    },
    {
      "id": "implementer",
      "kind": "agent",
      "label": "Implementer",
      "position": {
        "x": 20,
        "y": 272
      },
      "parent": "workspace",
      "adapter": "claude-code",
      "queue": [
        {
          "id": "tests-ready",
          "waitFor": [
            {
              "agent": "tester",
              "item": "red-check"
            }
          ]
        },
        {
          "id": "green-loop",
          "repeat": [
            {
              "id": "implement",
              "message": "Tests were just written for this. Find them, read them, and make them all pass: fix the code, not the tests.\n\n{{feature}}"
            },
            {
              "id": "green",
              "action": "Bash",
              "instruction": "Run the tests."
            }
          ],
          "until": {
            "kind": "succeeded"
          },
          "rounds": 3,
          "otherwise": "ask"
        }
      ]
    },
    {
      "id": "refactorer",
      "kind": "agent",
      "label": "Refactorer",
      "position": {
        "x": 20,
        "y": 492
      },
      "parent": "workspace",
      "adapter": "codex",
      "queue": [
        {
          "id": "implemented",
          "waitFor": [
            {
              "agent": "implementer"
            }
          ]
        },
        {
          "id": "refactor",
          "message": "Code was just written to pass the tests for this. Refactor it for clarity, naming and types, without touching the tests.\n\n{{feature}}"
        },
        {
          "id": "still-green",
          "action": "exec_command",
          "instruction": "Run the tests."
        },
        {
          "id": "broke",
          "if": {
            "kind": "failed"
          },
          "then": [
            {
              "id": "hand-back",
              "message": "The refactor broke tests. Find what changed, and make them pass again.",
              "target": "implementer"
            }
          ]
        }
      ]
    }
  ],
  "links": []
}
