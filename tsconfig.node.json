{
  // Core engine and its test helpers live under src/main/core/engine, included below.
  // Main process + preload script (bundled by Vite into CommonJS for Electron's Node runtime).
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "lib": ["ES2025"],
    "types": ["node"],
    // build/release.ts runs under plain Node as well, which needs its imports' extensions.
    "allowImportingTsExtensions": true
  },
  "include": ["src/main/**/*", "src/preload/**/*", "src/shared/**/*"]
}
