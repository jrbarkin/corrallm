{
  // Shared includes only model/view contracts; core engine helpers are outside this project.
  // Renderer (React, DOM). No Node types: the renderer is sandboxed and has no Node access.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.web.tsbuildinfo",
    "lib": ["ES2025", "DOM"],
    "types": ["vite/client"],
    "jsx": "react-jsx"
  },
  "include": ["src/renderer/**/*", "src/shared/**/*"]
}
